# ====================================================================
# Backend da Nossa Sessão 🍿
# Em produção estes valores vão no painel do Render (Environment).
# ====================================================================

PORT=3001
NODE_ENV=development

# Quem pode chamar a API. Em produção troque pela URL do app publicado.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Segredo compartilhado com o frontend (VITE_APP_TOKEN precisa ser igual).
# Gere um: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
APP_TOKEN=

# URL pública DESTE backend. É a base dos callbacks de OAuth e do
# proxy de IPTV, então precisa estar certa em produção.
PUBLIC_BASE_URL=http://localhost:3001

# Pra onde voltar depois de conectar Spotify/YouTube.
FRONTEND_URL=http://localhost:5173

# --------------------------------------------------------------------
# Supabase — use a SERVICE ROLE key, não a anon.
# É ela que permite ler a tabela oauth_accounts, que fica trancada
# pro frontend. NUNCA coloque esta chave no app React.
# --------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------------------------------
# Spotify — developer.spotify.com/dashboard (grátis, 2 minutos)
# Em "Redirect URIs" cadastre exatamente:
#   <PUBLIC_BASE_URL>/api/oauth/spotify/callback
# --------------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --------------------------------------------------------------------
# YouTube Music — console.cloud.google.com
# Ative a "YouTube Data API v3", crie um OAuth Client ID do tipo
# "Web application" e cadastre em "Authorized redirect URIs":
#   <PUBLIC_BASE_URL>/api/oauth/google/callback
# --------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --------------------------------------------------------------------
# Deezer — opcional.
# A Deezer fechou o cadastro de novos apps de API, então a conexão é
# feita pelo cookie "arl" da conta, colado direto no app (fica salvo
# no Supabase). Esta variável só serve de fallback global.
# --------------------------------------------------------------------
DEEZER_ACCESS_TOKEN=

# Alguns provedores de IPTV recusam requisição que não pareça um player.
IPTV_USER_AGENT=VLC/3.0.20 LibVLC/3.0.20
