# ====================================================================
# Frontend (Vite). Só variáveis VITE_* chegam no navegador —
# NUNCA coloque aqui a service_role do Supabase nem client secrets.
# O backend tem o próprio arquivo: server/.env.example
# ====================================================================

# Supabase (chave anon/publishable — pode ir pro navegador)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# TMDB (filmes)
VITE_TMDB_API_KEY=

# Data em que vocês começaram a namorar (contador da home)
VITE_RELATIONSHIP_START_DATE=2024-03-24

# ====================================================================
# Backend de música/IPTV
# Em dev pode deixar vazio: o Vite faz proxy de /api pra :3001.
# Em produção aponte pra URL do serviço no Render.
# ====================================================================
VITE_API_URL=

# Precisa ser IGUAL ao APP_TOKEN do backend.
VITE_APP_TOKEN=
